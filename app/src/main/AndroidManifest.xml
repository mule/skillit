<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Release A: only for the one-time ML Kit handwriting model download (#26). Handwriting never leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Merged in by ML Kit's WorkManager. The model download runs while the screen is open, so the app
         never needs to start at boot or run a foreground service (security review F2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove"/>
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="@string/app_name" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_skillit" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <!-- ML Kit has no supported switch for its usage logging. Removing the CCT (Firelog) backend leaves
             Google's datatransport pipeline with no backend that can upload, so usage events are dropped
             on the device (security review F1). Enforced by scripts/check-release-privacy.py. -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" android:exported="false">
            <meta-data android:name="backend:com.google.android.datatransport.cct.CctBackendFactory" tools:node="remove"/>
        </service>
    </application>
</manifest>
