#!/usr/bin/env bash
# Blocks pushes whose commits add scans/photos anywhere in their history,
# even if a later commit removed the file again.
# Enable once per clone: git config core.hooksPath scripts/hooks
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check-no-scans.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # deleting a ref
  if [[ "$remote_sha" == "$zero" ]]; then
    "$check" --range "$local_sha" --not --remotes || status=1   # new ref
  else
    "$check" --range "$remote_sha..$local_sha" || status=1
  fi
done
exit "$status"
