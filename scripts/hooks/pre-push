#!/usr/bin/env bash
# Blocks pushes whose commits add scans/photos anywhere in their history,
# even if a later commit removed the file again.
# Enable once per clone: git config core.hooksPath scripts/hooks
# Git calls this with: $1 = remote name (or URL), stdin = one line per ref.
# The allowlist used is the one committed in the commit being pushed.
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check-no-scans.sh"
remote="${1:-}"
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # deleting a ref
  if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range=("$remote_sha..$local_sha")
  elif [[ -n "$remote" ]] && git config --get "remote.$remote.url" >/dev/null &&
       [[ -n "$(git for-each-ref --count=1 "refs/remotes/$remote/")" ]]; then
    # New destination branch: skip only history already on THIS remote.
    # Other remotes (e.g. a private one) prove nothing about what is public here.
    range=("$local_sha" --not --remotes="$remote")
  else
    range=("$local_sha")  # unknown destination: check the full history
  fi
  "$check" --policy "$local_sha" --range "${range[@]}" || status=1
done
exit "$status"
